{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bergabenteuer",
  "compatibility_date": "2026-07-31",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "apps.larsfricke.com/bergabenteuer/*", "custom_domain": false }
  ]
}